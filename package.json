{
  "name": "whatsapp-shell",
  "productName": "Shell for WhatsApp",
  "version": "1.0.0",
  "description": "A fast, restyled desktop shell around WhatsApp Web",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "check": "node --check src/main.js && node --check src/themes.js && node --check src/settings.js && node -e \"require('./src/themes').buildCss({theme:'graphite',accent:null,lite:true,hideBackground:true,compact:true})\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.local.whatsapp-shell",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    }
  }
}
